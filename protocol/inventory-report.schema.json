{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://themark.net/grapheneos-mdm/protocol/inventory-report.schema.json",
  "title": "InventoryReport",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "deviceId", "osVersion", "securityPatch", "installedPackages"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "deviceId": { "type": "string", "minLength": 1 },
    "osVersion": { "type": "string", "minLength": 1 },
    "securityPatch": { "type": "string", "minLength": 1 },
    "securityPatchOk": {
      "type": "boolean",
      "description": "Set on the check-in after a desired state with minSecurityPatch was applied. Omitted when no floor is in effect."
    },
    "isDeviceOwner": { "type": "boolean" },
    "model": { "type": "string" },
    "users": {
      "type": "array",
      "description": "Calling user, then secondary users visible to the device owner.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["serial"],
        "properties": {
          "serial": { "type": "integer", "minimum": 0 },
          "secondary": { "type": "boolean" }
        }
      }
    },
    "osUpdater": {
      "type": "object",
      "additionalProperties": false,
      "description": "GrapheneOS System Updater package app.seamlessupdate.client.",
      "required": ["packageName", "installed"],
      "properties": {
        "packageName": { "type": "string" },
        "installed": { "type": "boolean" },
        "enabled": { "type": "boolean" },
        "versionName": { "type": "string" }
      }
    },
    "location": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "description": "Last recovery fix. Omitted unless locationEnabled was turned on. provider is gps, fused, or network.",
      "required": ["latitude", "longitude"],
      "properties": {
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "accuracyMeters": { "type": "number", "minimum": 0 },
        "provider": { "type": "string" },
        "time": { "type": "string", "format": "date-time" }
      }
    },
    "installedPackages": {
      "type": "array",
      "items": { "$ref": "#/$defs/packageVersion" }
    },
    "attestation": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "format": { "type": "string", "enum": ["none", "keymint", "raw-b64"] },
        "payloadB64": { "type": "string" },
        "verifiedBootState": { "type": "string" }
      },
      "required": ["format"]
    },
    "reportedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "packageVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packageName", "versionName"],
      "properties": {
        "packageName": { "type": "string", "minLength": 1 },
        "versionName": { "type": "string" },
        "versionCode": { "type": "integer" }
      }
    }
  }
}
