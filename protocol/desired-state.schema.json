{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://themark.net/grapheneos-mdm/protocol/desired-state.schema.json",
  "title": "DesiredState",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requiredPackages", "policyFlags"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "requiredPackages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["packageName"],
        "properties": {
          "packageName": { "type": "string", "minLength": 1 },
          "versionName": { "type": "string" },
          "minVersionCode": { "type": "integer" },
          "apkUrl": { "type": "string", "format": "uri" },
          "sha256": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{64}$",
            "description": "Hex SHA-256 of the APK bytes; required before install when apkUrl is set."
          },
          "signingCertSha256": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{64}$",
            "description": "Hex SHA-256 of the APK signing certificate (DER)."
          }
        }
      }
    },
    "policyFlags": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "disallowAddUser": { "type": "boolean" },
        "disallowFactoryReset": { "type": "boolean" },
        "disallowInstallUnknownSources": { "type": "boolean" },
        "cameraDisabled": { "type": "boolean" },
        "minSecurityPatch": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "Device SECURITY_PATCH must be this date or newer. The agent does not wipe; the next inventory reports securityPatchOk."
        },
        "passwordComplexity": {
          "type": "string",
          "enum": ["none", "low", "medium", "high"],
          "description": "Required password complexity. none clears it. Omit to leave the device alone."
        },
        "maximumTimeToLockMs": {
          "type": "integer",
          "minimum": 0,
          "description": "Lock timeout in milliseconds. 0 clears the limit. Omit to leave the device alone."
        },
        "suspendedPackages": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Full set of packages this agent should suspend. Omit to leave suspension alone. The agent package is ignored."
        },
        "hiddenPackages": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Full set of packages this agent should hide. Omit to leave hidden apps alone. The agent package is ignored."
        },
        "locationEnabled": {
          "type": "boolean",
          "description": "true turns the location radio on and the next inventory includes a GPS fix. false turns the radio off and stops reporting. Omit to leave the radio alone. The agent still holds location permission either way."
        },
        "usbDataSignalingEnabled": {
          "type": "boolean",
          "description": "false disables USB data signaling (charge-only). Omit to leave it alone."
        },
        "disallowConfigWifi": { "type": "boolean" },
        "disallowConfigMobileNetworks": { "type": "boolean" },
        "disallowUserSwitch": {
          "type": "boolean",
          "description": "true blocks switching Android users. false clears it. Omit to leave it alone."
        },
        "persistentPreferredActivities": {
          "type": "array",
          "description": "Full set of persistent preferred activities this agent manages. Omit to leave them alone. Empty clears only packages this agent set.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["packageName", "activity", "action"],
            "properties": {
              "packageName": { "type": "string", "minLength": 1 },
              "activity": { "type": "string", "minLength": 1 },
              "action": { "type": "string", "minLength": 1 },
              "categories": { "type": "array", "items": { "type": "string" } },
              "schemes": { "type": "array", "items": { "type": "string" } },
              "mimeType": { "type": "string" }
            }
          }
        },
        "permissionGrants": {
          "type": "array",
          "description": "Full set of runtime permission overrides for other apps. Omit to leave grants alone. Entries that drop off are reset to default. The agent package is ignored.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["packageName", "permission", "state"],
            "properties": {
              "packageName": { "type": "string", "minLength": 1 },
              "permission": { "type": "string", "minLength": 1 },
              "state": { "type": "string", "enum": ["granted", "denied", "default"] }
            }
          }
        },
        "lockTaskPackages": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["noop", "lock", "wipe", "reboot", "checkin_now", "check_os_update"]
          },
          "id": { "type": "string" }
        }
      }
    }
  }
}
